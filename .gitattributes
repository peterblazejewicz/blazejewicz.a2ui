# Auto-detect text files and normalize line endings to LF in both index and working tree
# across Windows, macOS, and Linux (matches .editorconfig `end_of_line = lf` and `dotnet format`).
* text=auto eol=lf

# Explicit text source/config types
*.cs      text eol=lf
*.csx     text eol=lf
*.axaml   text eol=lf
*.xaml    text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.slnx    text eol=lf
*.sln     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.xml     text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf

# Windows batch scripts require CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files — never modify bytes
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
*.pdf     binary
*.dll     binary
*.exe     binary
*.pdb     binary
*.nupkg   binary
*.snupkg  binary
*.zip     binary
*.gz      binary
