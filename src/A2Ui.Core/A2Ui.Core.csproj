<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Blazejewicz.A2Ui.Core</AssemblyName>
    <RootNamespace>Blazejewicz.A2Ui.Core</RootNamespace>
    <PackageId>Blazejewicz.A2Ui.Core</PackageId>
    <Description>A2UI (Agent-to-UI) message model and catalog for .NET</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="A2Ui.Core.Tests" />
    <InternalsVisibleTo Include="Blazejewicz.A2Ui.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
</Project>
